{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/admin",
      "dest": "public/admin.html"
    },
    {
      "src": "/privacy",
      "dest": "public/privacy.html"
    },
    {
      "src": "/politica-de-privacidad",
      "dest": "public/privacy.html"
    },
    {
      "src": "/privacy-policy",
      "dest": "public/privacy.html"
    },
    {
      "src": "/robots.txt",
      "dest": "public/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "public/sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
